generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------
// Database Tables
// ---------------------------

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  clubsJoined       Club[] @relation("ClubMembers")
  clubsPresided     Club[] @relation("ClubPresident")
  clubsVicePresided Club[] @relation("ClubVicePresident")
  clubsTechHeaded   Club[] @relation("ClubTechHead")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Club {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  tags        String[]
  presidentId     String   @db.Uuid
  president       User     @relation("ClubPresident", fields: [presidentId], references: [id])
  vicePresidentId String?  @db.Uuid
  vicePresident   User?    @relation("ClubVicePresident", fields: [vicePresidentId], references: [id])
  technicalHeadId String?  @db.Uuid
  technicalHead   User?    @relation("ClubTechHead", fields: [technicalHeadId], references: [id])
  members     User[]   @relation("ClubMembers")
  events      Event[]
  announcements Announcement[]
  projects Project[]
  resources Resource[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  createdAt   DateTime @default(now())
  clubId      String   @db.Uuid
  club        Club     @relation(fields: [clubId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  createdAt   DateTime @default(now())
  clubId      String   @db.Uuid
  club        Club     @relation(fields: [clubId], references: [id])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  link        String?  // Optional field for GitHub or demo links
  createdAt   DateTime @default(now())
  
  clubId      String   @db.Uuid
  club        Club     @relation(fields: [clubId], references: [id])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  url         String   // Link to a Google Drive PDF, Notion page, or website
  type        String?  // e.g., 'PDF', 'Note', 'Video'
  createdAt   DateTime @default(now())

  clubId      String   @db.Uuid
  club        Club     @relation(fields: [clubId], references: [id])
}

enum Role {
  STUDENT
  ADMIN
}